NODE_ENV=development # development | test | production.
PORT=8080
HOST=0.0.0.0

# Carried on every log line as `service`.
SERVICE_NAME=api-gateway

# fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Upstreams — one variable per row in src/config/service-registry.ts.
# ---------------------------------------------------------------------------
IDENTITY_SERVICE_URL=http://127.0.0.1:3001

# ---------------------------------------------------------------------------
# Token verification
# ---------------------------------------------------------------------------
JWT_ISSUER=https://identity.mktdash.local
JWT_AUDIENCE=mktdash
JWKS_URI=http://127.0.0.1:3001/.well-known/jwks.json
JWKS_CACHE_MAX_AGE_MS=300000
JWKS_COOLDOWN_MS=30000
JWKS_TIMEOUT_MS=5000
CLOCK_TOLERANCE_SECONDS=5

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_USERNAME=
REDIS_PASSWORD=local_dev_redis_password
REDIS_DB=0
REDIS_TLS=disable # disable | verify-full.
REDIS_COMMAND_TIMEOUT_MS=250

# ---------------------------------------------------------------------------
# Permission-version freshness
# ---------------------------------------------------------------------------
PERMISSION_VERSION_MODE=monitor

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Upstream calls
# ---------------------------------------------------------------------------
UPSTREAM_TIMEOUT_MS=15000
OPENAPI_FETCH_TIMEOUT_MS=3000

# ---------------------------------------------------------------------------
# Circuit breaker (defaults; a registry row may override per service)
# ---------------------------------------------------------------------------
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_ANONYMOUS_MAX=60

# ---------------------------------------------------------------------------
# Load shedding
# ---------------------------------------------------------------------------
MAX_EVENT_LOOP_DELAY_MS=1000
MAX_EVENT_LOOP_UTILIZATION=0.98
PRESSURE_RETRY_AFTER_SECONDS=10
